# Paperclip tenant env template — Deklo dashboard values.
# Source: /home/bhavya/EXAFLAIR-PAPERCLIP-PLAN.md §2. NO real values here — placeholders only.
# In Deklo: paste these as dashboard env vars (not a file). Never commit real secrets.

# --- Deployment mode (authenticated + public per plan §1/§2) ---
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=public

# Public base URL of THIS tenant (wildcard URL after first deploy, then update to final domain).
# Example pattern only: https://<app>-<hash>.<deklo-wildcard-domain>
PAPERCLIP_AUTH_PUBLIC_BASE_URL=
# Comma-separated hostnames the server will accept (no scheme, no port).
# Example pattern only: <app>-<hash>.<deklo-wildcard-domain>
PAPERCLIP_ALLOWED_HOSTNAMES=

# --- Secrets trio: EMPTY placeholders. Generate fresh per environment, never copy laptop values. ---
# Generate with: openssl rand -hex 32 (each, independently).
PAPERCLIP_AGENT_JWT_SECRET=
# Falls back to AGENT_JWT_SECRET if unset; set explicitly and keep stable across restarts/URL changes.
BETTER_AUTH_SECRET=
# No fallback — must be set.
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# --- Team hardening (plan §2) ---
PAPERCLIP_SECRETS_STRICT_MODE=true
PAPERCLIP_SECRETS_PROVIDER=local_encrypted
# Path inside container; back up master.key off-host day one (plan §3.4 / §5.5).
PAPERCLIP_SECRETS_MASTER_KEY_FILE=/home/paperclip/.paperclip/instances/default/secrets/master.key
# Prod: archive-only, no destructive delete.
PAPERCLIP_ENABLE_COMPANY_DELETION=false

# --- Tenant runtime contract (overrides VPS plan HOST=127.0.0.1) ---
# Deklo sets PORT itself — do NOT hardcode; app listens on $PORT. HOST must be 0.0.0.0 here.
HOST=0.0.0.0
PORT=3100

# --- Scale-up keys (commented until needed; plan §5.8 / §8) ---
# Embedded PG + local disk is the start shape. Uncomment when moving to hosted PG17 / S3.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/paperclip
# PAPERCLIP_STORAGE_PROVIDER=local_disk
# PAPERCLIP_S3_BUCKET=
# PAPERCLIP_S3_REGION=
# PAPERCLIP_S3_PREFIX=
# PAPERCLIP_S3_ENDPOINT=

# --- Heartbeat scheduler keys [needs-verify exact key names on pinned version] ---
# Resolve at deploy time with `paperclipai doctor` on 2026.1005.0; do not guess.
# HEARTBEAT_SCHEDULER_ENABLED=
# HEARTBEAT_SCHEDULER_INTERVAL_MS=

# --- Known naming conflicts (plan §2, resolve with `doctor`, do not guess) ---
# Prefer PAPERCLIP_AUTH_PUBLIC_BASE_URL (strict; wrong names fail doctor with
# `auth.publicBaseUrl is required`) over PAPERCLIP_PUBLIC_URL / PAPERCLIP_AUTH_BASE_URL_MODE.
# BETTER_AUTH_URL vs BETTER_AUTH_BASE_URL: prefer PAPERCLIP_AUTH_PUBLIC_BASE_URL unless doctor says otherwise.
# Never set PAPERCLIP_AUTH_DISABLE_SIGN_UP=true (kills invite flow — plan §4).
